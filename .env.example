# Supabase persistence (supabase/schema.sql). When unset, the server falls
# back to a local Deno KV database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (Supabase Auth / GoTrue). The anon key powers user-facing endpoints
# (signup, login, recovery emails); the service key is used for admin calls.
SUPABASE_ANON_KEY=your-anon-key

# Optional overrides
# PORT=8000
# TICK_MS=60000
# DENO_KV_PATH=./data/flockwatch.db
