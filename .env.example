# Supabase persistence (supabase/schema.sql). When unset, the server falls
# back to a local Deno KV database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (Supabase Auth / GoTrue). The anon key powers password login; the
# service key generates signup and recovery links without sending email.
SUPABASE_ANON_KEY=your-anon-key

# Transactional auth email delivery (https://resend.com). MAIL_ORIGIN_URL must be
# an allowed redirect URL in Supabase Auth. RESEND_FROM_EMAIL must use a
# verified Resend domain.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=FlockWatch <noreply@example.com>
MAIL_ORIGIN_URL=http://localhost:8000

# Optional overrides
# PORT=8000
# TICK_MS=60000
# DENO_KV_PATH=./data/flockwatch.db
