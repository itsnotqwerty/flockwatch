# Local PostgreSQL persistence and authentication (db/schema.sql).
DATABASE_URL=postgres://flockwatch:replace-me@127.0.0.1:5432/flockwatch
DENO_ENV=production

# Transactional email delivery. Use your HTTPS site origin and verified sender.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=FlockWatch <noreply@example.com>
MAIL_ORIGIN_URL=http://localhost:8000

# Optional overrides
# PORT=8000
# TICK_MS=60000
# DENO_KV_PATH=./data/flockwatch.db
